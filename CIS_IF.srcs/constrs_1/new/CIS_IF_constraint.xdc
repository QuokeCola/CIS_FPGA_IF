# --- RGMII receive clock from PHY ---
create_clock -period 8.000 -name RGMII_0_rxc -waveform {0.000 4.000} [get_ports RGMII_0_rxc]

# --- 1000M and 10/100M clock trees are mutually exclusive ---
set_clock_groups -logically_exclusive \
  -group [get_clocks -include_generated_clocks {gmii_clk_25m_out gmii_clk_2_5m_out}] \
  -group [get_clocks -include_generated_clocks gmii_clk_125m_out]

# --- cis_if divided clocks ---
create_generated_clock -name clk25 \
  -source [get_pins cis_if_module_i/cis_if_0/inst/clk25_raw_reg/C] \
  -divide_by 2 \
  [get_pins cis_if_module_i/cis_if_0/inst/clk25_raw_reg/Q]

create_generated_clock -name clk1_25 \
  -source [get_pins cis_if_module_i/cis_if_0/inst/clk1_25_raw_reg/C] \
  -divide_by 40 \
  [get_pins cis_if_module_i/cis_if_0/inst/clk1_25_raw_reg/Q]

# --- CDC declarations: all crossings are handled by RTL synchronizers ---
set_clock_groups -asynchronous \
  -group [get_clocks clk25] \
  -group [get_clocks clk1_25]

set_clock_groups -asynchronous \
  -group [get_clocks clk_fpga_2] \
  -group [get_clocks clk1_25]

set_clock_groups -asynchronous \
  -group [get_clocks clk_fpga_2] \
  -group [get_clocks clk25]

set_clock_groups -asynchronous \
  -group [get_clocks clk_fpga_1] \
  -group [get_clocks clk_fpga_2]

# --- AD9203 data bus timing (PLACEHOLDER - replace with datasheet values) ---
set_input_delay -clock clk25 -max 5.0 [get_ports {data_ad9203_0[*]}]
set_input_delay -clock clk25 -min 1.0 [get_ports {data_ad9203_0[*]}]